# Keep Python source LF on every platform, so hashes computed from
# the on-disk bytes match git blob hashes
# (see tests/test_direction_rules.py::test_rule_code_hash_matches_git_hash_object).
*.py text eol=lf

# Keep byte-compared U.3 artifacts LF on every platform: the generators
# write LF explicitly (toolkit/live_replay.py, toolkit/events.py) and the
# tests compare generated bytes against these committed files, so a
# Windows CRLF checkout breaks the byte comparison
# (see tests/test_live_replay.py::test_replay_rerender_is_byte_identical).
docs/workspace-replay.html text eol=lf
examples/agent-run-events.jsonl text eol=lf
examples/agent-run-events-2.jsonl text eol=lf
